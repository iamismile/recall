# Gemini API key used for the answer-generation (RAG) step.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Reranking provider: "local" (on-device cross-encoder, default) or "jina" (API).
# Use "jina" to avoid loading the local model (better for serverless / small hosts).
# RERANK_PROVIDER=local

# Required only when RERANK_PROVIDER=jina
# JINA_RERANKING_API_KEY=your-jina-key
# JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
