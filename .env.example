# Gemini API key used for the answer-generation (RAG) step.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Optional: override the model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Embedding provider: "local" (on-device MiniLM, default) or "gemini" (Gemini Embedding API).
# Use "gemini" for fast uploads on weak hardware. Requires GEMINI_API_KEY.
# NOTE: vectors are not compatible between providers — after switching,
# delete data/lancedb and re-index all documents.
EMBED_PROVIDER=local

# Optional: override the embedding model when EMBED_PROVIDER=gemini
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: Gemini embedding dimensions (3072 or 1536; default 768).
# Vectors are L2-normalized either way. Changing this requires re-indexing.
GEMINI_EMBED_DIMENSION=768

# Reranking provider: "local" (on-device cross-encoder, default) or "jina" (API).
# Use "jina" to avoid loading the local model (better for serverless / small hosts).
RERANK_PROVIDER=local

# Required only when RERANK_PROVIDER=jina
JINA_RERANKING_API_KEY=your-jina-key
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
